{
  "manifest_version": 3,
  "name": "净网助手 · 黄暴 / 垃圾 / 无效信息过滤",
  "version": "1.0.0",
  "description": "纯本地运行的网页内容过滤器：自动模糊色情图片、折叠色情与垃圾广告文案、清理灌水与重复无效信息，支持关键词自定义与站点白名单。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/common/filter-engine.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "净网助手",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "junk_ads",
        "enabled": false,
        "path": "rules/junk-ads.json"
      }
    ]
  }
}
